# DevSetup cloud backend - example environment file.
# Copy to .env and replace every dummy value. Never commit .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (required; SQLite is not used)
DB_NAME=devsetup
DB_USER=devsetup
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# CORS: list explicit origins, for example https://app.example.com
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# HTTPS-ready switches. Keep them off only for local development.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Authentication throttling (register/login/refresh)
AUTH_THROTTLE_RATE=10/min

# Maximum accepted request body for /api/setups/ (bytes).
# The setup payload itself is limited to 2 MB.
MAX_REQUEST_BYTES=4194304
